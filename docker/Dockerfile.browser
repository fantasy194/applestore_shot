# syntax=docker/dockerfile:1
ARG CHROMIUM_IMAGE=jlesage/chromium@sha256:e42de7469bce122b8a69d4f62101850ece45c41ed7ed952f2b506f99947093ae
FROM ${CHROMIUM_IMAGE}
RUN add-pkg python3 font-wqy-zenhei \
    && mkdir -p /data && chown 1000:1000 /data && chmod 0700 /data
COPY docker/browser-broker.py /opt/duo/browser-broker.py
COPY docker/browser-startapp.sh /startapp.sh
RUN chmod 0755 /startapp.sh
# Chromium is launched by the account worker, never with a shared default profile.
# Only the application's protected preview is exposed by Compose.
ENV KEEP_APP_RUNNING=1 WEB_LOCALHOST_ONLY=1 VNC_LISTENING_PORT=-1 \
    WEB_AUDIO=0 WEB_FILE_MANAGER=0 WEB_TERMINAL=0 WEB_NOTIFICATION=0 \
    USER_ID=1000 GROUP_ID=1000 UMASK=0077
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=12 \
    CMD ["python3", "/opt/duo/browser-broker.py", "--healthcheck"]
